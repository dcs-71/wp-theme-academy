{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/hero-slider",
	"version": "1.0.0",
	"title": "Academy · Hero Slider",
	"category": "media",
	"icon": "slides",
	"description": "Slider de portada accesible y ligero. Cada diapositiva es un bloque Cover totalmente editable.",
	"keywords": ["hero", "slider", "carrusel", "portada"],
	"textdomain": "academy",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"anchor": true
	},
	"attributes": {
		"autoplay": { "type": "boolean", "default": true },
		"loop": { "type": "boolean", "default": true },
		"delay": { "type": "number", "default": 6000 },
		"showArrows": { "type": "boolean", "default": true },
		"showDots": { "type": "boolean", "default": true }
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css"
}
